---
// Демо пятой идеи: печатающийся заголовок. Страница не в навигации и закрыта
// от индексации — она нужна, чтобы посмотреть на эффект, не ставя его на главную.
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>s31f.dev — typing demo</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  />
  <style>
    /* Печать через clip-path: строка просто открывается слева направо
       рывками, поэтому не нужно угадывать ширину текста и вёрстка не ломается
       на узком экране. */
    @keyframes type { to { clip-path: inset(0 0 0 0); } }
    @keyframes fade { to { opacity: 1; } }

    h1 .type { display: block; clip-path: inset(0 100% 0 0); }
    h1 .cursor { opacity: 0; }
    .lead, .cta { opacity: 0; }

    @media (prefers-reduced-motion: no-preference) {
      h1 .type:nth-of-type(1) { animation: type .85s steps(20) both; }
      h1 .type:nth-of-type(2) { animation: type 1.05s steps(26) .85s both; }
      h1 .cursor { animation: fade .01s 1.9s both, blink 1.1s step-end 1.9s infinite; }
      .lead { animation: fade .5s ease-out 2s both; }
      .cta { animation: fade .5s ease-out 2.2s both; }
    }
    @media (prefers-reduced-motion: reduce) {
      h1 .type { clip-path: none; }
      h1 .cursor, .lead, .cta { opacity: 1; }
    }

    .demo-note { color: var(--dim); font-size: 13px; display: flex; gap: 18px; }
    .demo-note a { color: var(--accent); }
  </style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <span class="name">s31f.dev</span>
    <span class="live">available for work</span>
    <span class="dim">remote</span>
    <a class="say" href="/">← back to the site</a>
  </header>

  <section class="panel whoami">
    <header><span>~/whoami</span><span>demo</span></header>
    <div class="inner">
      <h1>
        <span class="type">Fullstack developer.</span>
        <span class="type">Send the task, I'll ship it<span class="cursor" aria-hidden="true"></span></span>
      </h1>
      <p class="lead">
        Sites and web apps, Telegram bots, scrapers, integrations, AI features — and fixing code that someone else,
        or some AI tool, left broken. A one-hour task or a project that runs for months: both fine.
      </p>
      <div class="cta">
        <a class="btn btn-dark" href="/#contact">Send a task</a>
        <a class="btn btn-ghost" href="/#services">See what I do</a>
      </div>
    </div>
  </section>

  <p class="demo-note">
    <span>Пятая идея из списка: заголовок печатается сам, потом появляются абзац и кнопки.</span>
    <a href="/">на главную →</a>
  </p>

</div>
</body>
</html>
