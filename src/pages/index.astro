---
import "../styles/global.css";

const title = "s31f.dev";
const description =
  "Sites and web apps, Telegram bots, scrapers, integrations, AI features — and fixing code that someone else, or some AI tool, left broken.";

const STACK = [
  ["front", "Next.js · React · TypeScript"],
  ["back", "Node · Python · Postgres · Prisma"],
  ["bots", "Telegram Bot API · MTProto"],
  ["pay", "Stripe · PayPal"],
  ["infra", "Vercel · Netlify · Docker"],
  ["ai", "Claude Agent SDK · OpenAI API · RAG"],
];

const SERVICES = [
  {
    cmd: "build --site --web-app",
    text: "Landing pages, dashboards, shops, MVPs. Next.js, React, Astro, Node, Postgres.",
    price: "from $40",
  },
  {
    cmd: "build --telegram-bot",
    text: "Orders, bookings, payments, admin panel, AI answers from your own content.",
    price: "from $30",
  },
  {
    cmd: "automate --scrape --report",
    text: "Public data into Excel, Google Sheets or a database. Scheduled runs, alerts, reports.",
    price: "from $15",
  },
  {
    cmd: "connect --payments --crm",
    text: "Webhooks with signature checks, retries and logs, so nothing gets lost.",
    price: "from $30",
  },
  {
    cmd: "add --ai",
    text: "Assistants that answer from your own docs, text generation, agents that do the boring part.",
    price: "from $40",
  },
  {
    cmd: "fix --whatever-broke",
    text: "Bugs, failed deploys, someone else's code — including apps built in Lovable, Bolt or Cursor.",
    price: "from $25 · pay after it works",
  },
  {
    cmd: "something --else",
    text: "Not on the list? Describe it. If I can't do it well, I'll say so straight away.",
    price: "ask",
    ask: true,
  },
];

const STEPS = [
  ["You describe the task", "In plain words. A link, a screenshot or an error text helps."],
  ["I scope it", "Price and timing before I start. If it's a bad idea, I say so."],
  ["I build and test it", "You get it working, plus a short note on how it's put together."],
  ["You pay", "USDT or USDC. Small tasks after they work, longer projects in parts."],
];

// shot: путь внутри public/ без ведущего слеша, пока пусто — рисуется рамка с подписью
const WORK = [
  {
    name: "s31f.dev",
    text: "Astro · CSS — this page, a static one-pager.",
    shot: "",
  },
  {
    name: "Order hunter bot",
    text: "Node · Claude Agent SDK · Telegram — watches feeds, triages with an LLM, sends a card with a draft reply.",
    shot: "",
  },
  {
    name: "fix-my-app",
    text: "Static landing — the form opens Telegram or email with the message prefilled, no backend.",
    shot: "",
  },
];

const LINKS = [
  ["tg @s31fdev", "https://t.me/s31fdev"],
  ["s31f.dev@gmail.com", "mailto:s31f.dev@gmail.com"],
  ["discord s31f.dev", "https://discord.com/users/395999539850379265"],
  ["github.com/s31fdev", "https://github.com/s31fdev"],
];

const telegram = "https://t.me/s31fdev?text=Hi!%20I%20have%20a%20task%3A%20";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.site} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.site} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="Send the task, I'll ship it. Sites, bots, scrapers, integrations, AI features, and fixing what broke." />
  <link rel="icon" href={base + "favicon.svg"} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
<div class="wrap">

  <header class="top">
    <span class="name">s31f.dev</span>
    <span class="live">available for work</span>
    <span class="dim">remote</span>
    <span class="dim">UTC+0</span>
    <a class="say" href="#contact">say hi <span class="arr">→</span></a>
  </header>

  <div class="head">
    <section class="panel whoami">
      <header><span>~/whoami</span><span>01</span></header>
      <div class="inner">
        <h1>Fullstack developer.<br />Send the task, I'll ship it<span class="cursor" aria-hidden="true"></span></h1>
        <p class="lead">
          Sites and web apps, Telegram bots, scrapers, integrations, AI features — and fixing code that someone else,
          or some AI tool, left broken. A one-hour task or a project that runs for months: both fine.
        </p>
        <div class="cta">
          <a class="btn btn-dark" href="#contact">Send a task</a>
          <a class="btn btn-ghost" href="#services">See what I do</a>
        </div>
      </div>
    </section>

    <aside class="panel stack">
      <header><span>~/stack</span><span>02</span></header>
      <dl class="inner">
        {STACK.map(([key, value]) => <><dt>{key}</dt><dd>{value}</dd></>)}
      </dl>
    </aside>
  </div>

  <section class="panel services" id="services">
    <header><span>~/services</span><span>03</span></header>
    <div class="inner">
      {SERVICES.map((s) => (
        <div class:list={["svc", { ask: s.ask }]}>
          <span class="dollar" aria-hidden="true">$</span>
          <div><h3>{s.cmd}</h3><p>{s.text}</p></div>
          <span class="price">{s.price}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="panel steps">
    <header><span>~/how-it-works</span><span>04</span></header>
    <div class="inner">
      {STEPS.map(([name, text], i) => (
        <div><b>{i + 1}</b><h3>{name}</h3><p>{text}</p></div>
      ))}
    </div>
  </section>

  <section class="work" id="work">
    {WORK.map((w, i) => (
      <article class="panel">
        <header>~/work/{String(i + 1).padStart(2, "0")}</header>
        {w.shot ? <img class="shot" src={base + w.shot} alt={w.name} width="800" height="500" loading="lazy" />
                : <div class="shot">no screenshot yet</div>}
        <div class="meta"><h3>{w.name}</h3><p>{w.text}</p></div>
      </article>
    ))}
  </section>

  <section class="panel contact" id="contact">
    <header><span>~/contact</span><span>05</span></header>
    <div class="inner">
      <div>
        <h2>Tell me what you need</h2>
        <p>Describe the task in a couple of sentences. You get the price and the timing — usually the same day.</p>
        <div class="links">
          {LINKS.map(([name, href]) => <a href={href}>{name}</a>)}
        </div>
      </div>
      <a class="btn btn-accent" href={telegram}>Write on Telegram</a>
    </div>
  </section>

  <footer>
    <span>© {new Date().getFullYear()} s31f.dev</span>
    <span>built with <a href="https://astro.build">Astro</a></span>
  </footer>

</div>
</body>
</html>
